# CareBridge AI — Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git

# AWS Configuration
AWS_REGION=us-west-2
AWS_PROFILE=your-profile-name

# API Gateway (from SAM deploy output: ApiBaseUrl)
VITE_API_BASE_URL=https://your-api-id.execute-api.us-west-2.amazonaws.com/prod

# Bedrock (managed by SAM parameter, listed here for reference)
# BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0

# Bedrock Guardrail (set after guardrail creation)
# BEDROCK_GUARDRAIL_ID=your-guardrail-id
# BEDROCK_GUARDRAIL_VERSION=DRAFT

# DynamoDB Table Names (managed by SAM, listed here for reference)
# HOUSEHOLDS_TABLE=CareBridge-Households
# INCIDENTS_TABLE=CareBridge-Incidents
# DAILY_LOGS_TABLE=CareBridge-DailyLogs
# NOTIFICATIONS_TABLE=CareBridge-Notifications
# CONVERSATIONS_TABLE=CareBridge-Conversations

# Log Level
# LOG_LEVEL=INFO
